# انسخ هذا الملف إلى .env ثم غيّر القيم السرية قبل التشغيل.
# استخدم: openssl rand -hex 32 لإنتاج كلمة مرور PostgreSQL و AUTH_SECRET.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
AUTH_SECRET=replace-with-a-different-long-random-hex-value
APP_BASE_URL=http://localhost:3000
PORT=3000
POSTGRES_PORT=5432
STORAGE_DRIVER=local

# اختياري: تسجيل الدخول عبر Google OAuth.
# سجّل هذا العنوان كـ Authorized redirect URI في Google Cloud Console:
# https://your-domain.example/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# اختياري: استعادة كلمة المرور عبر البريد الإلكتروني.
SMTP_URL=
MAIL_FROM=Cloud Hard Drive <no-reply@example.com>

# اختياري لتخزين الملفات على S3 أو Cloudflare R2 بدلاً من volume محلي.
# عند إعداد جميع القيم، عيّن STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SSE=true
